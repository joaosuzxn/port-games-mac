{
  "name": "carros-steam",
  "app_name": "CarrosSteam",
  "bundle_id": "local.portcarros.carros-steam",
  "game_dir": "jogo",
  "exe_source": "Cars.exe",
  "exe_target": "Cars.exe",
  "exe_sha1": "d4a2f16e033ef096607404509efd5d3540eabf8e",
  "exclude": [
    "_jvm",
    "_uninst",
    "_CommonRedist",
    "steamapps",
    "THQ Website.url",
    "bak"
  ],
  "required_files": [
    "Data/Global.pak",
    "Data/UI.pak",
    "Data/misc.pak",
    "Data/Audio.pak",
    "Data/Scenes.pak",
    "Data/Act.pak",
    "Data/Res.pak",
    "binkw32.dll"
  ],
  "cd_label": "DISC2",
  "saves_dir": "THQ",
  "renderer": "wined3d",
  "registry": [
    {
      "hive": "system",
      "key": "Software\\Wine\\Drives",
      "values": {
        "d:": "cdrom"
      }
    },
    {
      "hive": "system",
      "key": "System\\ControlSet001\\Services\\winebus",
      "values": {
        "Enable SDL": 1,
        "Map Controllers": 1
      }
    },
    {
      "hive": "user",
      "key": "Software\\Wine\\X11 Driver",
      "values": {
        "EmulateModeset": "y"
      }
    },
    {
      "hive": "user",
      "key": "Software\\THQ\\Cars\\Settings\\Display",
      "values": {
        "Resolution": 14,
        "MultiSampleType": 4,
        "FullscreenEffects": 1
      }
    }
  ]
}